{
  "manifest_version": 2,
  "name": "ThinkPage Bridge",
  "version": "1.5.0",
  "description": "Bridges ThinkPage new-tab dashboard with Firefox browser history and search input auto-focus.",
  "permissions": [
    "history",
    "tabs",
    "cookies",
    "storage",
    "https://thinkpage.vercel.app/*",
    "file:///*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "ThinkPage Bridge",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": [
        "https://thinkpage.vercel.app/*",
        "file:///*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "thinkpage-bridge@naitiktuxx.github.io",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}


